<%- include("partials/header.ejs") %>

    <nav id="side-bar">
        <div class="title">
            <h3>BREATH OF THE WILD:</h3>
            <h4>Shrine Finder</h4>
        </div>
        
        <ul>
            <% regions.forEach(region=> {%>
                <li class="regions-list">
                    <a href="/region/<%= region.name %>">
                        <%= region.name %>
                    </a>
                </li>
                <% });%>
        </ul>
    </nav>

    <main>
        <div class="data-container">
            <% if (locals.shrines) {%>
                <h2>
                    <%= region %>
                </h2>
                <ul>
                    <% shrines.forEach(shrine=> { %>
                        <li class="shrine-list">
                            <%= shrine.name %>: <%= shrine.puzzle %>
                        </li>
                        <%})%>
                </ul>
                <%} else {%>
                    <h2> Select your region </h2>
                    <img src="images/sword-altar.svg" alt="master-sword" id="master-sword">
                    <% } %>
        </div>
    </main>

    <%- include("partials/footer.ejs") %>